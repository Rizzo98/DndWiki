{
  "rabbit_version": "3.13",
  "users": [
    { "name": "dnd", "password_hash": "", "hashing_algorithm": "rabbit_password_hashing_sha256", "tags": "administrator" }
  ],
  "vhosts": [ { "name": "/" } ],
  "permissions": [
    { "user": "dnd", "vhost": "/", "configure": ".*", "write": ".*", "read": ".*" }
  ],
  "exchanges": [
    { "name": "dnd.events", "vhost": "/", "type": "topic", "durable": true, "auto_delete": false, "internal": false, "arguments": {} }
  ],
  "queues": [
    { "name": "transcription.jobs", "vhost": "/", "durable": true, "auto_delete": false, "arguments": { "x-dead-letter-exchange": "dnd.events", "x-dead-letter-routing-key": "transcription.jobs.dlq", "x-consumer-timeout": 7200000 } },
    { "name": "transcripts.refine", "vhost": "/", "durable": true, "auto_delete": false, "arguments": { "x-dead-letter-exchange": "dnd.events", "x-dead-letter-routing-key": "transcripts.refine.dlq", "x-consumer-timeout": 7200000 } },
    { "name": "speakers.identify", "vhost": "/", "durable": true, "auto_delete": false, "arguments": { "x-dead-letter-exchange": "dnd.events", "x-dead-letter-routing-key": "speakers.identify.dlq", "x-consumer-timeout": 7200000 } },
    { "name": "content.generate", "vhost": "/", "durable": true, "auto_delete": false, "arguments": { "x-dead-letter-exchange": "dnd.events", "x-dead-letter-routing-key": "content.generate.dlq", "x-consumer-timeout": 7200000 } },
    { "name": "search.events", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "notification.events", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "transcription.jobs.dlq", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "transcripts.refine.dlq", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "speakers.identify.dlq", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "content.generate.dlq", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {} }
  ],
  "bindings": [
    { "source": "dnd.events", "vhost": "/", "destination": "transcription.jobs", "destination_type": "queue", "routing_key": "session.recorded", "arguments": {} },
    { "source": "dnd.events", "vhost": "/", "destination": "transcripts.refine", "destination_type": "queue", "routing_key": "transcription.completed", "arguments": {} },
    { "source": "dnd.events", "vhost": "/", "destination": "speakers.identify", "destination_type": "queue", "routing_key": "transcription.completed", "arguments": {} },
    { "source": "dnd.events", "vhost": "/", "destination": "speakers.identify", "destination_type": "queue", "routing_key": "transcription.refined", "arguments": {} },
    { "source": "dnd.events", "vhost": "/", "destination": "speakers.identify", "destination_type": "queue", "routing_key": "speakers.assigned", "arguments": {} },
    { "source": "dnd.events", "vhost": "/", "destination": "content.generate", "destination_type": "queue", "routing_key": "speakers.identified", "arguments": {} },
    { "source": "dnd.events", "vhost": "/", "destination": "content.generate", "destination_type": "queue", "routing_key": "speakers.assigned", "arguments": {} },
    { "source": "dnd.events", "vhost": "/", "destination": "content.generate", "destination_type": "queue", "routing_key": "summary.regenerate", "arguments": {} },
    { "source": "dnd.events", "vhost": "/", "destination": "content.generate", "destination_type": "queue", "routing_key": "summary.confirmed", "arguments": {} },
    { "source": "dnd.events", "vhost": "/", "destination": "content.generate", "destination_type": "queue", "routing_key": "plan.confirmed", "arguments": {} },
    { "source": "dnd.events", "vhost": "/", "destination": "search.events", "destination_type": "queue", "routing_key": "wiki.published", "arguments": {} },
