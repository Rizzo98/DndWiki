    { "source": "dnd.events", "vhost": "/", "destination": "notification.events", "destination_type": "queue", "routing_key": "wiki.draft_ready", "arguments": {} },
    { "source": "dnd.events", "vhost": "/", "destination": "notification.events", "destination_type": "queue", "routing_key": "speaker.pending", "arguments": {} },
    { "source": "dnd.events", "vhost": "/", "destination": "notification.events", "destination_type": "queue", "routing_key": "session.published", "arguments": {} },
    { "source": "dnd.events", "vhost": "/", "destination": "notification.events", "destination_type": "queue", "routing_key": "wiki.published", "arguments": {} }
