# Copy to .env.local and adjust.
#
# Base URL of the API gateway (Traefik) — must resolve from both the browser
# and the Next.js server (the UI proxies every call server-side to avoid CORS).
# Add "127.0.0.1 api.dnd.localhost" to C:\Windows\System32\drivers\etc\hosts.
NEXT_PUBLIC_API_BASE_URL=http://api.dnd.localhost
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=dnd
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=dnd-web
