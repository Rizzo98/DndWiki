# ============================================================================
# DnD Wiki — environment configuration (copy to .env and adjust)
# ============================================================================

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=info

# --- PostgreSQL ---
POSTGRES_USER=dnd
POSTGRES_PASSWORD=dnd
POSTGRES_DB=dnd

# --- RabbitMQ ---
RABBITMQ_USER=dnd
RABBITMQ_PASSWORD=dnd

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=dndminio
MINIO_ROOT_PASSWORD=dndminio123

# --- Meilisearch ---
MEILI_MASTER_KEY=dndsearchkey

# --- Keycloak ---
KEYCLOAK_REALM=dnd
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Secret for the confidential client `dnd-services` (service-to-service calls)
KEYCLOAK_SERVICE_CLIENT_SECRET=change-me

# --- Transcription (WhisperX) ---
# Required: pyannote diarization models are gated — accept the license at
# https://huggingface.co/pyannote/speaker-diarization-3.1 and put a token here.
HF_TOKEN=
WHISPER_MODEL=small
# Force the device: "cuda" | "cpu" | empty (default) = auto-detect.
# The worker runs fully on CPU out of the box (float16 falls back to int8 —
# the ASR backend is faster-whisper/CTranslate2; float32 OOMs with large
# models). Use a smaller model (e.g. small/medium) for CPU throughput.
WHISPER_DEVICE=
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
# Alignment checkpoints pre-downloaded at container start (comma-separated ISO
# codes, e.g. "it,en"). The wav2vec2 VoxPopuli checkpoints are cached under
# TORCH_HOME on the models volume, so they survive container recreates.
PREWARM_LANGUAGES=it

# --- Speaker identification ---
VOICE_EMBEDDING_MODEL=speechbrain/spkrec-ecapa-voxceleb
# Minimum cosine similarity to auto-assign a speaker; below this the DM is asked.
SPEAKER_MATCH_THRESHOLD=0.75
# Naming a speaker in the UI also enrolls that speaker's voice (extracted from
# the session recording) as a session-derived voiceprint, so future sessions
# with the same voice are named automatically.

# --- Speaker re-clustering (override untrusted raw diarizer labels) ---
# Embed each turn, cluster by voice (cosine agglomerative), relabel, then match.
RELABEL_ENABLED=true
# "threshold" (cosine cut; default, robust to unknown speaker count) | "count" (K = distinct raw labels)
RELABEL_MODE=threshold
RELABEL_MERGE_THRESHOLD=0.5
RELABEL_ANCHOR_THRESHOLD=0.6
RELABEL_MIN_TURN_SEC=1.0
# Force the number of speakers K (0 = auto). E.g. a DM who knows there are 5 players.
RELABEL_SPEAKER_COUNT=0

# --- LLM contextual diarization (refiner-service) ---
# A stage between transcription and speaker identification: an LLM fixes
# transcription errors and speaker attribution (turn-level, context-driven)
# and rewrites the transcript before voiceprint matching. Set false to keep
# the old flow (speaker-service re-clusters raw labels itself).
# The LLM prompt is enriched with the campaign cast (character names +
# physical descriptions, from campaign-service) so it can correct misheard
# names and recognize who is speaking.
REFINER_ENABLED=true
# Uses the same LLM configuration as content generation (LLM_PROVIDER,
# LLM_MODEL, DEEPSEEK_API_KEY/OPENAI_API_KEY/... above). Optional override
# for a dedicated editor model (e.g. deepseek/deepseek-chat):
# REFINER_MODEL=
# Editing should be deterministic; keep near 0.
REFINER_TEMPERATURE=0.0
REFINER_MAX_TOKENS=4096
# Corrective retries per window when the LLM returns malformed JSON
REFINER_JSON_RETRIES=1
# Version of the refinement prompt/schema (recorded on the rewritten artifacts)
REFINER_PROMPT_VERSION=v3
# Long sessions are refined in sliding windows: turns per call + overlap
# (overlap turns are already-finalized context reused for label consistency)
REFINER_WINDOW_TURNS=100
REFINER_WINDOW_OVERLAP=15

# --- LLM (content generation) ---
# Any provider supported by LiteLLM: deepseek/*, openai/*, anthropic/*, ollama/*, ...
# The provider is selected by the model prefix (deepseek/deepseek-chat etc.).
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek/deepseek-chat
# Version of the extraction prompt/schema (recorded per generation job)
PROMPT_VERSION=v1
# Transcript chunking + parallel per-chunk LLM calls
CHUNK_TOKENS=4000
CHUNK_OVERLAP=0.1
LLM_CHUNK_CONCURRENCY=4
# Corrective retries per chunk when the LLM returns malformed JSON
LLM_JSON_RETRIES=1
# API keys — placeholders for now; fill before running content generation.
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=      (also used for the API transcription variant below)
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Transcription (API variants — docker-compose.transcription.yml) ---
# One compose override, three interchangeable cloud backends for the
# transcription service (replaces on-prem WhisperX). The engine is selected
# with TRANSCRIPTION_PROVIDER (deepgram | openai | assemblyai):
#   TRANSCRIPTION_PROVIDER=assemblyai docker compose -f docker-compose.yml -f docker-compose.transcription.yml up -d --build
#   TRANSCRIPTION_PROVIDER=deepgram   docker compose -f docker-compose.yml -f docker-compose.transcription.yml up -d --build
#   TRANSCRIPTION_PROVIDER=openai     docker compose -f docker-compose.yml -f docker-compose.transcription.yml up -d --build
# (docker-compose.api.yml still works as the OpenAI-only form.)
TRANSCRIPTION_PROVIDER=deepgram

# --- Deepgram Speech-to-Text (Nova 3, built-in diarization) ---
# Required for the Deepgram variant. Get a key at https://console.deepgram.com
DEEPGRAM_API_KEY=
DEEPGRAM_TRANSCRIPTION_MODEL=nova-3
# BCP-47 language hint (e.g. it, en, it-IT). Empty = language=multi: Nova
# auto-detects per chunk. NOTE: unlike OpenAI, Deepgram's default when the
# parameter is omitted is ENGLISH — auto-detection must be requested
# explicitly, which is what the empty default does.
DEEPGRAM_LANGUAGE=
DEEPGRAM_SMART_FORMAT=true
DEEPGRAM_PUNCTUATE=true
# Long recordings are decoded locally (ffmpeg, no ML) and sliced into
# fixed-length chunks; 300 s of 16 kHz mono PCM WAV is ~9.2 MiB per chunk.
# Deepgram accepts larger payloads — raise this if you prefer fewer calls.
DEEPGRAM_CHUNK_SECONDS=300
# Safety cap per uploaded WAV chunk.
DEEPGRAM_MAX_UPLOAD_MB=24

# --- OpenAI Speech-to-Text (gpt-4o-transcribe-diarize) ---
# Required for the OpenAI variant; needs access to gpt-4o-transcribe-diarize.
# This same key is reused by content-service when LLM_MODEL starts with
# "openai/" (see the LLM section above).
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
# Optional ISO-639-1 language hint (e.g. it); empty = server auto-detect.
OPENAI_TRANSCRIPTION_LANGUAGE=
# Long recordings are decoded locally (ffmpeg, no ML) and sliced into
# fixed-length chunks because OpenAI caps each transcription upload at 25 MB.
# 300 s of 16 kHz mono PCM WAV is ~9.2 MiB per chunk.
OPENAI_CHUNK_SECONDS=300
# Safety cap per uploaded WAV chunk — keep below OpenAI's 25 MB hard limit.
OPENAI_MAX_UPLOAD_MB=24

# --- AssemblyAI Speech-to-Text (Universal-3.5 Pro, built-in diarization) ---
# Required for the AssemblyAI variant. Get a key at https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=
# Comma-separated fallback chain is allowed (e.g. universal-3-5-pro,universal-2).
ASSEMBLYAI_TRANSCRIPTION_MODEL=universal-3-5-pro
# Language hint override; EMPTY = use the campaign's language (campaign-service),
# falling back to AssemblyAI auto-detection.
ASSEMBLYAI_LANGUAGE=
# Contextual prompt (what the audio is about) for Universal-3.5 Pro; EMPTY =
# built-in D&D-session prompt enriched with the campaign name/description.
ASSEMBLYAI_PROMPT=
# Inject the campaign roster names as keyterms_prompt so fantasy names are
# transcribed accurately.
ASSEMBLYAI_KEYTERMS_ENABLED=true
# Long recordings are decoded locally (ffmpeg, no ML) and sliced into
# fixed-length chunks; 300 s of 16 kHz mono PCM WAV is ~9.2 MiB per chunk.
ASSEMBLYAI_CHUNK_SECONDS=300
# Safety cap per uploaded WAV chunk.
ASSEMBLYAI_MAX_UPLOAD_MB=24

# --- Session recording ---
MAX_UPLOAD_MB=512

# --- Web debug tools (apps/web) ---
# No env needed: the developer-only buttons (rerun wiki generation on a
# session, delete-all pages on the campaign wiki) are unlocked by assigning
# the "dev" realm role to a user in Keycloak.